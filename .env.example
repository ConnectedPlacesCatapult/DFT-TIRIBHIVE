# TRIB / HIVE Environment Variables
# Same names work on Vercel dashboard and Azure Application Settings

# ---------------------------------------------------------------------------
# Data provider — controls which backend the HIVE handbook uses
# Values: "json" (L0 offline fallback) | "supabase" (Phase A) | "azure" (Phase B)
# ---------------------------------------------------------------------------
DATA_PROVIDER=json

# ---------------------------------------------------------------------------
# Supabase — dedicated HIVE project (separate from shared Sparkworks/Atlas project)
# Required when DATA_PROVIDER=supabase or DATA_PROVIDER=azure (for pgvector)
# ---------------------------------------------------------------------------
HIVE_SUPABASE_URL=https://afysgjiczzptubonbuxs.supabase.co
HIVE_SUPABASE_ANON_KEY=

# Legacy fallback names (used by other parts of the app)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Azure Postgres — Phase B production database
# Required when DATA_PROVIDER=azure
# ---------------------------------------------------------------------------
AZURE_POSTGRES_URL=

# Discrete host/user/password (used by admin health checks, feedback, sync scripts)
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_USER=
AZURE_POSTGRES_PASSWORD=
AZURE_POSTGRES_DB=postgres

# ---------------------------------------------------------------------------
# Admin UI — server-side session (middleware + /admin/login + beta menu unlock)
#
# Set this value in EVERY runtime environment (not only .env):
#   • Azure App Service → Configuration → Application settings → ADMIN_PASSWORD
#   • Vercel → Project → Settings → Environment variables → add for Production,
#     Preview, and Development (if you want admin on all preview URLs)
#   • GitHub Actions → Repository → Settings → Secrets and variables → Actions
#     → add secret ADMIN_PASSWORD (used at build time in deploy workflows)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
# Optional: separate secret for HMAC session cookie (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase service role — optional; required for feedback Azure→Supabase sync only
# ---------------------------------------------------------------------------
HIVE_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App version — stored with each feedback row (optional)
# ---------------------------------------------------------------------------
APP_VERSION=

# ---------------------------------------------------------------------------
# AI — embeddings + intent detection + report synthesis
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
AI_FORCE_DISABLED=false

# ---------------------------------------------------------------------------
# Analytics — Google Analytics 4
# Optional: leave blank to disable GA4 tracking
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# App
# Phase A: Vercel URL | Phase B: trib.org.uk
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
NODE_ENV=development
